# E2E test environment template.
# Run `./apps/e2e/setup-env.sh` to generate .env.test: it copies this file, then
# fills the Secrets Manager-sourced values (Cognito IDs + test-user creds) below.
# The values kept here are the non-secret local defaults.

BASE_URL=http://localhost:5173

# ─── DynamoDB Local ─────────────────────────────────────────────────────
DYNAMODB_TABLE=packpixie-test
LOCAL_DYNAMODB_URL=http://localhost:8000
AWS_REGION=us-east-1

# ─── API server ──────────────────────────────────────────────────────────
PORT=3001

# ─── Cognito — populated by setup-env.sh from AWS Secrets Manager ────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ─── Test user — provisioned by Terraform (infra/cognito.tf); creds pulled
#     by setup-env.sh from Secrets Manager (pack-pixie/e2e-test-user-*) ─────
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ─── Vite client env vars ────────────────────────────────────────────────
# VITE_APP_VERSION is required by apps/client/src/config.ts — must not be blank
VITE_APP_VERSION=test
VITE_API_URL=http://localhost:3001
# populated by setup-env.sh from AWS Secrets Manager
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=
